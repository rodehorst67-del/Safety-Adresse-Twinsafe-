:root{--ink:#1e2933;--yellow:#ffd343;--muted:#65727d}body{background:linear-gradient(155deg,#f9fafb,#e9eef2)}header{background:linear-gradient(130deg,#ffe273,#ffc928);border-bottom:0;padding-top:calc(28px + env(safe-area-inset-top));box-shadow:0 7px 30px #c5961324}header .eyebrow{display:inline-block;background:#24313a;color:#ffe17b;padding:7px 11px;border-radius:7px;letter-spacing:1.4px}header h1{font-size:clamp(27px,6vw,38px);letter-spacing:-1px}main{padding-bottom:calc(60px + env(safe-area-inset-bottom))}.panel{border:1px solid #e0e5e9;box-shadow:0 12px 32px #20354a0d;border-radius:22px}.pill{background:#fff1bd;border-color:#eac451;color:#554315}.switches{background:linear-gradient(180deg,#f6f8fa,#e8edf0);border:1px solid #ccd5dc;padding:15px 9px;border-radius:18px;box-shadow:inset 0 1px 2px #fff}.track{background:linear-gradient(90deg,#9ba7b1,#c3ccd3 17%,#a6b2bc 50%,#c3ccd3 83%,#9ba7b1);border:2px solid #75818c;border-radius:10px;height:92px;box-shadow:inset 0 2px 7px #25344345,0 1px 1px #fff}.track:after{content:'';position:absolute;left:50%;top:18%;bottom:18%;width:3px;transform:translateX(-50%);background:#63717d70;border-radius:3px}.thumb{z-index:1;height:35px;background:linear-gradient(180deg,#fff,#e5edf3 40%,#cfd9e1);border:1px solid #9eacb7;box-shadow:0 3px 6px #1a2b3c55;border-radius:6px}.thumb:after{content:'';position:absolute;left:20%;right:20%;top:48%;height:2px;background:#a6b4bd;box-shadow:0 -5px #c1cbd3,0 5px #aab8c1}.dip.on .track{border-color:#11855c;box-shadow:inset 0 2px 7px #25344345,0 0 0 2px #1eab7040}.dip.on .state{color:#087d51}.dip.off .state{color:#596674}.number{background:#fff;border:1px solid #d2dbe2;border-radius:7px;padding:5px 0;max-width:45px;margin:0 auto 9px}.state{font-size:13px}.bank-title{margin-bottom:14px}.bank-title strong{font-size:17px}button{min-height:47px;background:#26323b}button:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #f3bd13;outline-offset:3px}button:disabled{opacity:.5}.actions button:first-child{background:#f5c928;color:#20272e}.install-note{font-size:12px;color:#56636f;margin:12px 0 0;line-height:1.5}@media(max-width:460px){.track{height:82px}.thumb{height:31px}.switches{padding:12px 5px}.bank-title span{max-width:42%;text-align:right}.actions button{flex:1}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}
footer.credit{text-align:center;padding:18px 12px 30px;font-size:13px;font-weight:700;color:#53616c;letter-spacing:.3px}header .eyebrow{font-size:16px;letter-spacing:1.8px}</style></head><body><header><div class="eyebrow">CONTINENTAL</div><h1>TwinSAFE FSoE</h1><p>DIP-Schalter schnell und übersichtlich einstellen</p></header><main><section class="panel"><h2>1 · Adresse eingeben</h2><div class="fields"><div><label for="type">Klemmentyp</label><select id="type"><option>EL1904</option><option>EL2904</option><option>KL1904</option><option>KL2904</option></select></div><div><label for="address">FSoE-Adresse (dezimal)</label><input id="address" type="number" min="0" max="65535" step="1" value="1" inputmode="numeric"></div></div><p class="hint" id="range"></p><p class="hint error" id="error" role="alert"></p></section><section class="panel"><div class="status"><h2 style="margin:0">2 · DIP-Schalterstellung</h2><span class="pill" id="badge">EL1904 · Adresse 1</span></div><div id="banks"></div><div class="legend"><span><i class="dot"></i>1 = oben / ON</span><span><i class="dot off"></i>0 = unten / OFF</span></div></section><section class="panel"><h2>3 · Übersicht</h2><p id="binary" style="font-size:14px;overflow-wrap:anywhere"></p><div class="actions"><button id="copy">Einstellung kopieren</button><button onclick="window.print()">Drucken / PDF</button></div><p class="install-note">Auf dem iPhone: In Safari öffnen → Teilen → „Zum Home-Bildschirm“. Dafür muss diese App über HTTPS bereitgestellt werden.</p></section><p class="foot">Die Zuordnung entspricht den Formeln der bereitgestellten Excel: EL1904/EL2904 verwenden DIP 1–8 (Bits 0–7) und DIP 9–16 (Bits 8–15); KL1904/KL2904 verwenden DIP 1–10 (Bits 0–9). Diese Web-Version wurde nicht an einer realen Safety-Hardware validiert. Adresse und Schalterstellung vor Inbetriebnahme anhand der Herstellerdokumentation prüfen.</p><footer class="credit">by Kevin Rodehorst</footer><script>
const type=document.getElementById('type'),address=document.getElementById('address'),banks=document.getElementById('banks'),error=document.getElementById('error'),badge=document.getElementById('badge'),range=document.getElementById('range'),binary=document.getElementById('binary');let current='';
function render(){let el=type.value.startsWith('EL'),max=el?65535:1023,n=Number(address.value),valid=address.value.trim()!==''&&Number.isInteger(n)&&n>=0&&n<=max;address.max=max;range.textContent=`Zulässiger Darstellungsbereich: 0–${max.toLocaleString('de-DE')} (entsprechend ${el?16:10} DIP-Bits).`;error.textContent=valid?'':`Bitte eine ganze Adresse zwischen 0 und ${max.toLocaleString('de-DE')} eingeben.`;banks.innerHTML='';binary.textContent='';badge.textContent=type.value+(valid?' · Adresse '+n:' · Eingabe prüfen');document.getElementById('copy').disabled=!valid;if(!valid){banks.innerHTML='<div class="empty">Bitte eine gültige Adresse eingeben.</div>';return}let groups=el?[{title:'DIP 9–16',start:9,end:16},{title:'DIP 1–8',start:1,end:8}]:[{title:'DIP 1–10',start:1,end:10}];let all=[];for(let g of groups){let wrap=document.createElement('div');wrap.className='bank';let bits=[];for(let i=g.start;i<=g.end;i++){let bit=Math.floor(n/2**(i-1))%2;bits.push(bit);all.push(`${i}:${bit}`)}wrap.innerHTML=`<div class="bank-title"><strong>${g.title}</strong><span>Schalter nach Excel-Zuordnung</span></div><div class="switches ${el?'':'ten'}">${bits.map((bit,j)=>`<div class="dip ${bit?'on':'off'}" aria-label="DIP ${g.start+j}: ${bit?'oben, 1':'unten, 0'}"><div class="number">${g.start+j}</div><div class="track"><div class="thumb"></div></div><div class="state">${bit?'1 ↑':'0 ↓'}</div></div>`).join('')}</div><div class="direction"><span>↑ OBEN = 1</span><span>UNTEN = 0 ↓</span></div>`;banks.appendChild(wrap)}current=`${type.value} | FSoE-Adresse ${n}\n`+all.join('  ');binary.textContent='Binär (höchstes Bit zuerst): '+n.toString(2).padStart(el?16:10,'0');}
type.addEventListener('change',render);address.addEventListener('input',render);document.getElementById('copy').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(current);document.getElementById('copy').textContent='Kopiert ✓';setTimeout(()=>document.getElementById('copy').textContent='Einstellung kopieren',1500)}catch(e){alert('Kopieren ist in diesem Browser nicht verfügbar.')}});render();
if ("serviceWorker" in navigator && location.protocol.startsWith("http")) navigator.serviceWorker.register("sw.js").catch(()=>{});
</script></body></html>
